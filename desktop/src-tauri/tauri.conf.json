{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "机械选型引擎",
  "version": "0.1.0",
  "identifier": "com.mds.selector",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["mds-server/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    },
    "shortDescription": "机械设计物料选型引擎",
    "longDescription": "AI 辅助、过程可逐行验证、离线可用的机械物料选型工具。所有数值由确定性引擎计算，AI 不参与计算。"
  }
}
